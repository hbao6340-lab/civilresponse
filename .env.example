# CIVIRESPOND — copy to .env.local and fill in. NEVER commit .env.local.
# Public (safe for browser build) — restricted by RLS + server checks.
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Server-only — NEVER prefixed with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Optional integrations (Phase 5+)
# CAPTCHA (Cloudflare Turnstile)
TURNSTILE_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
